<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.1.1.3</Version>
    <AssemblyName>HarmoniaEngine</AssemblyName>
    <RootNamespace>Harmonia</RootNamespace>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageProjectUrl>https://github.com/AngelicaProject/Harmonia</PackageProjectUrl>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Plugin manifest; keep in sync with repo.json. -->
    <Author>pokeda</Author>
    <Name>Harmonia</Name>
    <Punchline>Play Final Fantasy XIV in your language with community translations.</Punchline>
    <Description>Shows Final Fantasy XIV in another language using community translations. Add a translation from the link or file its author gives you, turn it on, and restart the game. Translations update themselves. Characters the game's own fonts don't have, such as Cyrillic in window titles, need Penumbra.</Description>
    <RepoUrl>https://github.com/AngelicaProject/Harmonia</RepoUrl>
    <Tags>localization;translation;harmonia</Tags>
    <IconUrl>https://raw.githubusercontent.com/AngelicaProject/Harmonia/main/Harmonia/Assets/Icon/harmonia_icon.png</IconUrl>
    <ApplicableVersion>any</ApplicableVersion>
    <LoadRequiredState>2</LoadRequiredState>
    <LoadSync>true</LoadSync>
    <LoadPriority>2147483647</LoadPriority>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <!-- Serves the pack's font glyphs through a temporary mod; optional at runtime. -->
    <PackageReference Include="Penumbra.Api" Version="5.15.1" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="DotNet.ReproducibleBuilds" Version="2.0.5" />
  </ItemGroup>

  <ItemGroup>
    <!-- UI dictionaries: embedded baseline plus on-disk copies in <plugin>/Localization. -->
    <EmbeddedResource Include="Assets/Localization/en.json">
      <LogicalName>Localization.en.json</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Assets/Localization/ru.json">
      <LogicalName>Localization.ru.json</LogicalName>
    </EmbeddedResource>
    <Content Include="Assets/Localization/*.json">
      <Link>Localization/%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
